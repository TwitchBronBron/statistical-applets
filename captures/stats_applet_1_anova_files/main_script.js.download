    label.attr('stroke', '#0000FF');
    // make this italic
    var line = this.paper.path("M" + this.plot_x + " " + (this.plot_y + 5*this.distance_btwn_lines + this.axis_offset_y) + "L" + (this.plot_x + this.line_length) + " " + (this.plot_y + 5*this.distance_btwn_lines + this.axis_offset_y));
    line = this.paper.path("M" + this.plot_x + " " + (this.plot_y + 5*this.distance_btwn_lines + this.axis_offset_y - 5) + "L" + this.plot_x + " " + (this.plot_y + 5*this.distance_btwn_lines + this.axis_offset_y));
