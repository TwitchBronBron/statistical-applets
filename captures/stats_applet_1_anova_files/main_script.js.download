    line.attr('stroke', '#0000FF');
    var text = this.paper.text(this.plot_x + Math.floor(this.line_length*position), this.plot_y + 5*this.distance_btwn_lines + this.axis_offset_y - 15, 0.001);
    text.attr("stroke", '#0000FF');
    text.attr("font-family", "Arial");    
}
module_main.get_position_on_axis = function(number){
    return -Math.log(number)*0.25/Math.log(10);    
}

$(window).load(function(){
    module_main.initialize();
});



